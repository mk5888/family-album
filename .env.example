PORT=3000
# Generate with: openssl rand -hex 32  (required; rotating it signs everyone out and changes all media URLs)
SESSION_SECRET=replace-with-at-least-32-random-bytes
# Per-person secret links, no typing needed. Create with: npm run invite -- 媽媽 https://album.example.com
# Format: name|token,name|token  (remove an entry to revoke that person)
INVITES=
# Optional shared passcode (leave blank to use invite links only).
PASSCODE=
# Keep true when the app is behind HTTPS (the production default).
COOKIE_SECURE=true
# Days a login lasts: passcode logins / invite-link logins.
SESSION_DAYS=7
INVITE_SESSION_DAYS=180
# public = signed media URLs may be cached by Cloudflare (fast in China); private = never cached.
MEDIA_CACHE=public
CACHE_MINUTES=10
# Never commit real shared-album links. Format: name|URL,name|URL
ALBUMS=Family album|https://photos.app.goo.gl/replace-me
