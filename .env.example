PORT=3000
# Use a long, unique passphrase. Leave blank only when Cloudflare Access is enabled.
PASSCODE=replace-with-a-long-unique-passphrase
# Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-at-least-32-random-bytes
# Keep true when the app is behind HTTPS (the production default).
COOKIE_SECURE=true
CACHE_MINUTES=10
# Never commit real shared-album links. Format: name|URL,name|URL
ALBUMS=Family album|https://photos.app.goo.gl/replace-me
